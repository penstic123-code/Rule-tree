{
  "name": "ruletree",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.21.1",
  "publisher": "shidipeng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/penstic123-code/Rule-tree.git"
  },
  "homepage": "https://github.com/penstic123-code/Rule-tree#readme",
  "bugs": {
    "url": "https://github.com/penstic123-code/Rule-tree/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "bin": {
    "ruletree": "./bin/ruletree.js"
  },
  "files": [
    "bin/",
    "hooks/",
    "src/",
    "media/",
    "extension.js",
    "README.md",
    "LICENSE",
    "package.nls.json",
    "package.nls.zh-cn.json"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.claude/rules/ruletree/*.md",
    "workspaceContains:需求树.md"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ruletree",
          "title": "%view.container%",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "ruletree": [
        {
          "type": "webview",
          "id": "ruletree.panel",
          "name": "%view.panel%"
        }
      ]
    },
    "commands": [
      {
        "command": "ruletree.create",
        "title": "%cmd.create%"
      },
      {
        "command": "ruletree.enable",
        "title": "%cmd.enable%"
      },
      {
        "command": "ruletree.disable",
        "title": "%cmd.disable%"
      },
      {
        "command": "ruletree.refresh",
        "title": "%cmd.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "ruletree.openMap",
        "title": "%cmd.openMap%",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "ruletree.checkup",
        "title": "%cmd.checkup%"
      },
      {
        "command": "ruletree.checkupReport",
        "title": "%cmd.checkupReport%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ruletree.openMap",
          "when": "view == ruletree.panel",
          "group": "navigation@0"
        },
        {
          "command": "ruletree.refresh",
          "when": "view == ruletree.panel",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "ruletree.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh%",
            "%config.language.en%"
          ],
          "description": "%config.language%"
        },
        "ruletree.memoryMode": {
          "type": "string",
          "enum": [
            "keep",
            "treeOnly"
          ],
          "default": "keep",
          "enumDescriptions": [
            "%config.memoryMode.keep%",
            "%config.memoryMode.treeOnly%"
          ],
          "description": "%config.memoryMode%"
        }
      }
    }
  }
}
